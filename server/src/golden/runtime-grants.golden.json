  "grants": {
    "claude": {
      "grant": {
        "login": "host-login",
        "anthropic": true,
        "connections": [
          {
            "id": "stripe",
            "name": "stripe",
            "env": "STRIPE_KEY",
            "placeholder": "seti-placeholder-stripe",
            "hosts": [
              "api.stripe.com"
            ],
            "header": {
              "name": "Authorization",
              "template": "Bearer {value}"
            },
            "minted": false,
            "body": false
          },
          {
            "id": "openai",
            "name": "openai",
            "env": "OPENAI_API_KEY",
            "placeholder": "seti-placeholder-openai",
            "hosts": [
              "api.openai.com"
            ],
            "header": {
              "name": "Authorization",
              "template": "Bearer {value}"
            },
            "minted": false,
            "body": false
          },
          {
            "id": "docs",
            "name": "docs",
            "env": "DOCS_TOKEN",
            "placeholder": "seti-placeholder-docs",
            "hosts": [
              "*.docs.example.test"
            ],
            "header": null,
            "minted": false,
            "body": false
          }
        ],
        "mcp": [
          "https://mcp.example.test/mcp"
        ],
        "deniedConnectors": [],
        "caHosts": [
          "mcp.example.test",
          "api.stripe.com",
          "api.openai.com",
          "docs.example.test"
        ]
      },
      "denied": [
        "claude.ai Gmail",
        "srv_off"
      ]
    },
