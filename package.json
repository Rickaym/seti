{
  "name": "seti",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.32.1"
  },
  "scripts": {
    "dev:server": "pnpm --filter @seti/server dev",
    "dev:ui": "pnpm --filter @seti/ui dev",
    "build": "pnpm --filter @seti/ui build",
    "start": "pnpm --filter @seti/server start",
    "doctor": "pnpm --silent --filter @seti/server run doctor",
    "setup-code": "pnpm --silent --filter @seti/server setup-code",
    "mod": "node scripts/mod.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run check-types",
    "lint": "node scripts/lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:text": "node scripts/check-text.mjs",
    "check:site": "bash site/build.sh",
    "check:ea": "cd ea && uv sync --locked --quiet && uv run ruff format --check . && uv run ruff check . && uv run pyright && uv run pytest -q",
    "banner": "node scripts/banner.mjs",
    "android:release": "node scripts/android-release.mjs",
    "test": "pnpm -r run test",
    "e2e": "pnpm --filter @seti/e2e e2e",
    "screenshots": "pnpm build && pnpm --filter @seti/e2e screenshots",
    "build:demo": "node scripts/build-demo.mjs",
    "demo": "pnpm build && pnpm build:demo && bash scripts/demo.sh",
    "check": "pnpm format:check && pnpm check:text && pnpm check:site && pnpm typecheck && pnpm lint && pnpm knip && pnpm test && pnpm check:ea && pnpm build",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^9.39.5",
    "@types/estree": "^1.0.10",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "simple-git-hooks": {
    "pre-commit": "[ -s \"$HOME/.nvm/nvm.sh\" ] && . \"$HOME/.nvm/nvm.sh\" >/dev/null && nvm use >/dev/null; pnpm exec lint-staged",
    "commit-msg": "[ -s \"$HOME/.nvm/nvm.sh\" ] && . \"$HOME/.nvm/nvm.sh\" >/dev/null && nvm use >/dev/null; pnpm exec commitlint --edit \"$1\"",
    "pre-push": "[ -s \"$HOME/.nvm/nvm.sh\" ] && . \"$HOME/.nvm/nvm.sh\" >/dev/null && nvm use >/dev/null; pnpm typecheck && pnpm knip"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored",
      "node scripts/check-text.mjs"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write",
      "node scripts/check-text.mjs"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "simple-git-hooks"
    ],
    "overrides": {
      "@modelcontextprotocol/sdk": ">=1.31.0"
    }
  }
}
